
# Default API target for the flight Streamlit container when it runs in Docker Compose.
FLIGHT_PRICE_API_URL=http://flight-api:5002

# Keep real tokens only in your local environment. Do not commit real values.
NGROK_AUTHTOKEN=replace_with_your_ngrok_token

# Keep this false while the existing Azure subscription or AKS cluster is stopped.
# Setting it to true enables the Jenkins CD job and allows successful CI builds to trigger Azure deployment.
VOYAGE_AZURE_DEPLOYMENT_ENABLED=false

# Jenkins follows main in normal use. A temporary branch can be selected for isolated CI testing.
VOYAGE_GIT_BRANCH=main

# Airflow checks the flight dataset every day at 02:00 UTC. Use an empty value for manual-only runs.
AIRFLOW_FLIGHT_TRAINING_SCHEDULE="0 2 * * *"
